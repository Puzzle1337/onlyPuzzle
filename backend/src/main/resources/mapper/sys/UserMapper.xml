<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.onlypuzzle.system.login.mapper.UserMapper">
    <select id="login" parameterType="com.example.onlypuzzle.system.login.model.User" resultType="com.example.onlypuzzle.system.login.model.User">
        select * from sys_user where username = #{username}
    </select>
    <insert id="insert" parameterType="com.example.onlypuzzle.system.login.model.User" useGeneratedKeys="true" keyProperty="id">
        insert into sys_user (username, password) values (#{username}, #{password})
    </insert>
    <select id="findByUsername" parameterType="java.lang.String" resultType = "java.lang.Integer">
       select count(*) from sys_user where username = #{username}
    </select>
</mapper>